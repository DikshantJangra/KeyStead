# Switch agent bridge base URL. GET $SWITCH_URL/health should return 200.
SWITCH_URL=http://localhost:8000
# The client's Switch registration token. Used once, by `keystead register`.
KEYSTEAD_REG_TOKEN=
# 32 random bytes, base64. `keystead init` generates one.
KEYSTEAD_MASTER_KEY=
# Where agent.json, vault.json, keystead.db and audit.jsonl live.
KEYSTEAD_DATA_DIR=./data
KEYSTEAD_CONFIG=./config/keystead.yaml
